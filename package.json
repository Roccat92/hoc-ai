{
  "name": "learn-ai-vietnamese",
  "version": "1.0.0",
  "private": true,
  "description": "Thư viện mở học lập trình và build sản phẩm với AI cho người Việt",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "node scripts/tao-thumbnail.mjs && vitepress build",
    "docs:preview": "vitepress preview",
    "kiem-tra-chuoi": "node scripts/kiem-tra-chuoi.mjs",
    "kiem-tra-ngay-cu": "node scripts/kiem-tra-ngay-cu.mjs",
    "docs:check": "npm run kiem-tra-chuoi && npm run docs:build && npm run kiem-tra-anchor && npm run kiem-tra-code",
    "tao-thumbnail": "node scripts/tao-thumbnail.mjs",
    "kiem-tra-anchor": "node scripts/kiem-tra-anchor.mjs",
    "kiem-tra-code": "node scripts/kiem-tra-code.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.33.4",
    "vitepress": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
